# true  → demo data baked into the frontend (src/api/mock.ts). Everything works,
#         nothing hits the network. This is what you want for the demo.
# false → talk to the real backend (src/api/http.ts).
VITE_USE_MOCK=true

# Where the FastAPI backend is. VITE_API_URL wins; VITE_API_BASE_URL still works.
VITE_API_URL=http://127.0.0.1:8000
