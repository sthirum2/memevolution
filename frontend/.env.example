# false = talk to the real backend: real agent, real predictor, real Gemini.
#         This is the fully wired mode. Needs the backend running (./dev.sh).
# true  = demo data baked into the frontend. Every screen works with no backend,
#         which is the safe choice if you are presenting on unfamiliar wifi.
VITE_USE_MOCK=false

VITE_API_URL=http://127.0.0.1:8000
