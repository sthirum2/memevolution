# Local fallback (relative to the directory where uvicorn is started).
DATABASE_URL=sqlite:///./memevolution.db
# Tiger Data: copy connection details from your service; URL-encode passwords.
# Standard postgresql:// URLs are also accepted and use the installed psycopg driver.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# PostgreSQL mode requires TimescaleDB and permission to initialize the hypertable.
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Gemini — writes the meme concepts AND generates the images.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Instagram API with Facebook Login; keep these server-side.
IG_ACCESS_TOKEN=
IG_USER_ID=
PUBLIC_MEDIA_BASE=
IG_GRAPH_VERSION=v21.0
