"""
Turn a meme concept into an actual generated video, via Veo.

Mirrors generate_image.py: same google-genai SDK, same GEMINI_API_KEY, same
"try the real model, fall back to a safe local render on any failure" shape.
Callers should never have to special-case a missing key or a flaky API.

Two things make video different from the image path:

  * Generation is asynchronous. `generate_videos` returns an Operation, not
    the video itself — you poll it until `operation.done`. This can take
    anywhere from ~20s to a few minutes, so callers running inside a request
    handler should use BackgroundTasks (see backend/app/main.py) rather than
    block on this synchronously.
  * Veo needs a Gemini API key on a paid/billing-enabled tier. This repo's
    Gemini account already has that (Veo subscription), so this uses the
    exact same GEMINI_API_KEY as generate_image.py — no second key to manage.

Falls back to render.py's image_to_video() (the silent ffmpeg loop of the
still frame) when Veo is unavailable or fails for any other reason (rate
limit, transient error, etc.), so publishing never breaks outright.
"""

from __future__ import annotations

import os
import time
from pathlib import Path

from .render import OUT_DIR

from .env import load_dotenv

load_dotenv()  # so a key in backend/.env is picked up

DEFAULT_MODEL = "veo-3.1-fast-generate-preview"
MAX_POLL_SECONDS = 300  # give up after 5 minutes rather than hang the worker
POLL_INTERVAL_SECONDS = 15

# Same "don't look like AI slop" direction as generate_image.py's STYLE,
# adapted for motion instead of a static frame.
STYLE = (
    "Shot on a phone camera, handheld and slightly imperfect, natural available "
    "light, candid and unposed, mildly grainy, looks like a real clip someone "
    "actually filmed and posted, not a polished ad or a stock video. No text or "
    "captions burned into the footage, no watermarks, no logos."
)


def build_prompt(visual_description: str, topic: str = "", extra: str = "") -> str:
    parts = [visual_description.strip()]
    if topic:
        parts.append(f"Setting: {topic.replace('_', ' ')}.")
    parts.append(STYLE)
    if extra:
        parts.append(extra)
    return " ".join(p for p in parts if p)


def generate_video(
    prompt: str,
    out_path: Path,
    duration_seconds: int = 8,
    aspect_ratio: str = "9:16",  # vertical, matches TikTok/Reels/Shorts
    model: str = DEFAULT_MODEL,
    api_key: str | None = None,
) -> Path | None:
    """Ask Veo for the video. Returns None if it is unavailable, never raises."""
    api_key = api_key or os.environ.get("GEMINI_API_KEY")
    if not api_key:
        return None

    try:
        from google import genai
        from google.genai import types
    except ImportError:
        print("[video] google-genai not installed - pip install google-genai")
        return None

    try:
        client = genai.Client(api_key=api_key)

        operation = client.models.generate_videos(
            model=model,
            prompt=prompt,
            config=types.GenerateVideosConfig(
                aspect_ratio=aspect_ratio,
                duration_seconds=duration_seconds,
            ),
        )

        waited = 0
        while not operation.done:
            if waited >= MAX_POLL_SECONDS:
                print(f"[video] timed out after {MAX_POLL_SECONDS}s waiting on Veo")
                return None
            time.sleep(POLL_INTERVAL_SECONDS)
            waited += POLL_INTERVAL_SECONDS
            operation = client.operations.get(operation)

        if operation.error:
            print(f"[video] Veo returned an error: {operation.error}")
            return None

        videos = getattr(operation.response, "generated_videos", None) or []
        if not videos:
            print("[video] no video came back from Veo")
            return None

        out_path.parent.mkdir(parents=True, exist_ok=True)
        client.files.download(file=videos[0].video)
        videos[0].video.save(str(out_path))
        return out_path

    except Exception as exc:  # never let content generation break the loop
        print(f"[video] generation failed ({type(exc).__name__}: {exc})")
        return None


def make_meme_video(
    experiment_id: str,
    headline: str,
    punchline: str | None,
    visual_description: str,
    still_image_path: Path,
    topic: str = "",
    out_dir: Path | None = None,
    model: str = DEFAULT_MODEL,
) -> tuple[Path, str]:
    """
    The whole path: generate a real video with Veo, burn the exact headline/
    punchline onto it, or fall back to looping the already-rendered still
    frame (which already has its caption burned in by generate_image.py).

    `still_image_path` is the meme JPEG generate_image.py already produced —
    used as the fallback source, not fed into the Veo prompt.

    Caption burning is treated as part of "did this succeed": a raw Veo
    video with no caption on it is not an acceptable result on its own, so
    a failure at that step falls all the way back to the ffmpeg loop rather
    than returning captionless Veo footage.

    Returns (path, source) where source is 'veo' or 'fallback', so callers
    (publish.py) can tell the operator which one they are looking at, same
    as make_meme_image()'s ('gemini' or 'fallback').
    """
    out_dir = out_dir or OUT_DIR
    out_dir.mkdir(parents=True, exist_ok=True)
    raw = out_dir / f"{experiment_id}_raw.mp4"
    final = out_dir / f"{experiment_id}.mp4"

    prompt = build_prompt(visual_description, topic, extra=headline)
    got = generate_video(prompt, raw, model=model)
    if got:
        from .render import burn_captions_onto_video

        try:
            burn_captions_onto_video(got, final, headline, punchline)
            raw.unlink(missing_ok=True)
            return final, "veo"
        except Exception as exc:
            print(f"[video] caption overlay failed, falling back ({type(exc).__name__}: {exc})")

    from .render import image_to_video

    return image_to_video(still_image_path, out_path=final), "fallback"
