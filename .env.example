# ─────────────────────────────────────────────────────────────────────────────
# Shared configuration. Copy the two per-service files and edit those:
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env
# This file documents how they fit together.
# ─────────────────────────────────────────────────────────────────────────────

# backend/.env
#   DATABASE_URL=sqlite:///./memevolution.db      local file, no server needed
#   CORS_ORIGINS=http://localhost:5173            must include the frontend origin

# frontend/.env
#   VITE_USE_MOCK=true        demo data, nothing hits the backend
#   VITE_USE_MOCK=false       talk to the real backend
#   VITE_API_URL=http://127.0.0.1:8000

# Optional semantic memory. Export these for CLI use, or put in backend/.env
# for the backend's existing environment loader. Reuse the assistant across restarts.
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
